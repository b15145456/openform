DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
FRONTEND_ORIGIN=https://openform-frontend.onrender.com
PORT=3000

# Neon Object Storage (media uploads) — from `neon env pull` after `neon deploy`
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2

# Auth (Better Auth) — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# First-boot admin account (only used once, when the user table is empty)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Authorization (OpenFGA) — per-app owner/editor/viewer sharing
FGA_API_URL=http://localhost:8080
# Required in production (anyone with the URL could otherwise write
# permission tuples directly); leave unset for local dev against an
# unsecured local OpenFGA instance.
FGA_API_KEY=
